rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in player can look at (and list) every pet; only the owner can write theirs.
    match /pets/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.ownerId == userId
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 30
        && request.resource.data.status in ['NORMAL', 'ESTRUS', 'SLEEPING', 'SICK']
        && request.resource.data.petName is string
        && request.resource.data.petName.size() <= 16
        // Older documents have no breed yet; the client fills in the default on load.
        && (!('breed' in request.resource.data)
          || request.resource.data.breed in ['shiba', 'husky', 'choco', 'dalmatian', 'pug', 'poodle', 'golden']);
      allow delete: if false;
    }
  }
}
