rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each (anonymous) user can only read and write their own pet.
    match /pets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.ownerId == userId
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 30
        && request.resource.data.status in ['NORMAL', 'ESTRUS', 'SLEEPING', 'SICK']
        && request.resource.data.petName is string
        && request.resource.data.petName.size() <= 16;
      allow delete: if false;
    }
  }
}
