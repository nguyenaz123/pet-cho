# --- Auth.js (NextAuth v5) ---
# Random secret used to sign cookies. Generate one with: npx auth secret
AUTH_SECRET=
# Meta for Developers > your app > App settings > Basic
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Shown on /privacy, /terms and /data-deletion as the contact address.
CONTACT_EMAIL=

# --- Database (PostgreSQL) ---
# e.g. postgres://user:password@localhost:5432/pixel_pet
DATABASE_URL=

# Game speed multiplier. 100 = a full stat bar drains in about 10 minutes.
# Set to 1 for real time (production).
NEXT_PUBLIC_TIME_SCALE=100
